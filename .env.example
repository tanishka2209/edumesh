# Copy this file to .env and put real keys only in .env. Never commit the real .env file.
GROQ_API_KEY=your_key_here
# Optional backup speech-to-text provider used if Groq transcription fails.
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# Groq model used to create subject answers.
MODEL_NAME=openai/gpt-oss-20b
# Leave as groq to use live AI answers.
ANSWER_MODE=groq
# Local URLs used when running without Docker/Kubernetes.
ML_URL=http://127.0.0.1:5001
DBMS_URL=http://127.0.0.1:5002
CLOUD_URL=http://127.0.0.1:5003
